; ----------------------------------------------------------------------------------------------------------------
;
; IxForecasts.job
;
; TP+ script to create a daily matrix that includes internal/external, external/internal, and external/external
; passenger vehicle travel based on the average daily commute trips from CTPP 2012-2016 data, combined with assumptions
; on WFH pre-pandemic and post-pandemic difference.  These trip tables are based on total
; traffic counts, which include trucks; trucks are pulled out from these tables in a subsequent step, IxTimeOfDay.job.
;
; A 2021 matrix is used as the base year; see documentation in utilities/ix-ex. This script generates estimates
; for the forecast years 2021 and after. The growth rates were discussed with neighboring MPOs as
; part of the SB 375 target setting process.
;
; Input:  (1)  Station-specific assumed growth rates and commute shares for each forecast year
;              (the lack of external/external movements through the region allows simple factoring of cells
;              without re-balancing) (ixex_config.dbf)
;         (2)  An input base matrix (ixDaily2021.tpp) and totals (ixDaily2021_totals.dbf)
;         (3)  Environment variables: %MODEL_YEAR% (e.g. 2021 and after) and
;                                     %FUTURE% (only PBA50 is supported now)
;
; Output: (1) Four-table, forecast-year specific trip tables containing internal/external, external/internal, and
;             external/external vehicle travel. (nonres\ixDailyx4.tpp)
;
; Notes:  (1)
;
; See also: (1) IxTimeOfDay.job, which applies diurnal factors to convert this P/A matrix to an time-period-specific
;               O/D matrix.
;
; version:  Travel Model One
; authors:  dto (2010 12 30), lmz (2018 12 31), lmz (2023 11 17)
;
; ----------------------------------------------------------------------------------------------------------------
token_future = '%FUTURE%'
FIRST_EXT_ZONE = %FIRST_EXTERNAL_ZONE%
TOT_ZONES = %TOTAL_ZONES%

; for 2005, just the use 2005 matrix
IF (%MODEL_YEAR% == 2005)
  *copy nonres\ixDaily2005.tpp nonres\ixDailyx4.tpp
  EXIT
ENDIF

; for 2015, just use the 2015 matrix
IF (%MODEL_YEAR% == 2015)
  *copy nonres\ixDaily2015.tpp nonres\ixDailyx4.tpp
  EXIT
ENDIF

IF (%MODEL_YEAR% < 2021)
  print LIST="MODEL_YEAR less than 2021 is not supported (except for 2015)"
  ABORT
ENDIF

IF (%MODEL_YEAR% == 2021)
  *copy nonres\ixDaily2021.tpp nonres\ixDailyx4.tpp
  EXIT
ENDIF

; ----------------------------------------------------------------------------
; SNABM MODIFICATION (2026-06-08): the original MTC TM1.6 RUN PGM=MATRIX
; block at this location had hardcoded MTC zone IDs (1454, 1461, 1462, 1475)
; and arrays sized for MTC's 21 external zones, with a custom X/X correction
; for the 1461/1462 gateway pair. None of that works for SNABM 2440-zone
; (36 externals at 2441..2476). The JEF TODO at original line 121 had
; acknowledged this gap was open since at least 2015.
;
; Replacement: Kevin-style uniform growth from a base-year IX matrix,
; borrowed from data_prep_scripts/IxForecasts_fromKevin.job (Marin model).
; The base matrix is nonres/ixDaily2015.tpp (2476-zone SNABM, equal-share
; RENUMBER from a 2376-zone source -- see SNABM_1.6_2023data/
; data_prep_scripts/renumber_ixDaily2015.s). Growth assumption: uniform
; 0.5%/year compound, applied to every cell that touches an external
; gateway (zone >= FIRST_EXTERNAL_ZONE = 2441). Internal-internal cells in
; an IX matrix are 0 and stay 0.
;
; Limitations of this interim approach:
;   - Flow values are 2015-vintage; refresh when 2023 external counts arrive.
;   - Uniform growth ignores per-gateway differential trends.
;   - The 2005/2015/2021 short-circuits above are preserved unchanged.
; ----------------------------------------------------------------------------
RUN PGM = MATRIX

   MATI = nonres\ixDaily2015.tpp
   MATO = nonres\ixDailyx4.tpp, mo=1-4,
     name = ix_daily_da, ix_daily_sr2, ix_daily_sr3, total

   jloop
      mw[1] = mi.1.ix_daily_da
      mw[2] = mi.1.ix_daily_sr2
      mw[3] = mi.1.ix_daily_sr3

      ; Only cells touching an external gateway get growth applied.
      if (i >= @FIRST_EXT_ZONE@ || j >= @FIRST_EXT_ZONE@)
         mw[1] = mw[1] * pow(1.005, %MODEL_YEAR% - 2015)
         mw[2] = mw[2] * pow(1.005, %MODEL_YEAR% - 2015)
         mw[3] = mw[3] * pow(1.005, %MODEL_YEAR% - 2015)
      endif

      mw[4] = mw[1] + mw[2] + mw[3]
   endjloop

ENDRUN
