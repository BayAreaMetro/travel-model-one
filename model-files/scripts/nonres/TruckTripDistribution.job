; ----------------------------------------------------------------------------------------------------------------
;
; TruckTripDistribution.job
;
; As part of the TM-1.7 Freight Model Update, and as documented in GitHub Issue #99, the distribution model was
; transitioned from the prior BAYCAST time-based impedance to a distance-based impedance, and new friction factor
; curves were estimated for each of the four truck classes: very small trucks (two-axle, four-tire), small trucks
; (two-axle, six-tire), medium trucks (three-axle), and large or combination (four-or-more-axle) trucks.
;
; The friction factor curves use a gamma function of the form F(d) = a * d^b * exp(c * d). The 'b' and 'c' parameters
; were calibrated by Nelder-Mead optimization, fitting each modeled trip length frequency distribution (TLFD) to a
; reference TLFD.  The reference distributions were derived from the CSF2TDM 2020 OD demand matrices for the small,
; medium, and large truck classes; the very small truck class has no equivalent vehicle class in CSF2TDM, so its
; target was taken from the TM-1.6 OD pattern. The 'a' parameter is a scaling constant, selected to keep the friction
; factors at a magnitude similar to the previous model implementation.  The resulting curves are written to
; truckFF_distance_based.dat. The documentation and estimation code live in:
; utilities/trucks/trucks_2026_update/src/models/trip_distribution.
;
; The impedance measure is a truck-class-specific blended distance: a weighted combination of the non-tolled and
; tolled path distance, with the tolled share set by TRUCK_DISTRIB_LOS_TOLL_PART (configured in hwyParam.block).
;
; The previous distribution model was derived from BAYCAST and used a blended travel time (one-third AM peak plus
; two-thirds midday) as the impedance, along with k-factors calibrated by Chuck Purvis.  The TM-1.7 update
; described above supersedes that approach; the k-factors are no longer applied.
;
; Input:  (1) Level-of-service matrices for the midday period (10 am to 3 pm) which contain truck-class-specific
;             path distances (in miles) using the following table names: (a) DISTVSM / TOLLDISTVSM for very small
;             trucks; (b) DISTSML / TOLLDISTSML for small trucks; (c) DISTMED / TOLLDISTMED for medium trucks; and,
;             (d) DISTLRG / TOLLDISTLRG for large trucks.  The tolled share blended into the impedance is
;             configured by TRUCK_DISTRIB_LOS_TOLL_PART in hwyParam.block.
;         (2) Trip generation results in ASCII format with the following fields (each 12 columns wide): (a) zone
;             number; (b) very small truck trip productions; (c) very small truck trip attractions; (d) small truck
;             trip productions; (e) small truck trip attractions; (f) medium truck trip productions; (g) medium
;             truck trip attractions; (h) large truck trip productions; and, (i) large truck trip attractions.
;         (3) A table of distance-based friction factors in ASCII format (truckFF_distance_based.dat) with the
;             following fields (each 12 columns wide): (a) impedance measure (blended distance); (b) friction
;             factors for very small trucks; (c) friction factors for small trucks; (d) friction factors for
;             medium trucks; and, (e) friction factors for large trucks.
;
; Output: (1) A four-table production/attraction trip table matrix of daily class-specific truck trips (in units
;             of trips x 100, to be consistent with the previous application) with a table for (a) very small
;             trucks, (b) small trucks, (c) medium trucks, and (d) large trucks.
;
; Notes:  (1) The small, medium, and large truck friction factors were re-estimated for TM-1.7 by fitting modeled
;             TLFDs to CSF2TDM 2020 OD patterns; the very small truck target was taken from TM-1.6 (see Issue #99).
;         (2) The k-factors used in the prior BAYCAST implementation are no longer applied.
;
; See also: (1) TruckTripGeneration.job, which applies the generation model.
;           (2) TruckTimeOfDay.job, which applies diurnal factors to the daily trips generated here.
;           (3) TruckTollChoice.job, which applies a toll/no toll choice model for trucks.
;
; version:  Travel Model One (1.7+)
; authors:  Juan Caicedo — WSP (2026 08 10); lmz (2022 12 01); dto (2011 09 08); dto (2010 08 31); cp (date unknown)
;
;
; ----------------------------------------------------------------------------------------------------------------

; set the number of zones token
token_number_of_internal_zones = 1454

; step one: create the blended (non-tolled/tolled) truck distance matrix
run pgm = matrix

   ; distribute via cluster
   DistributeIntrastep processid = 'CTRAMP', processlist = 1-2, commpath = '%COMMPATH%', saveprn = f

   read file = ctramp\scripts\block\hwyParam.block
   
   ; read in the midday period commercial skims
   filei mati[1] = skims\com_hwyskimMD.tpp
   
   ; write out the blended travel distance for each truck class
   fileo mato[1] = nonres\blendedTruckDistance.tpp, mo = 1-4, name = distanceVSM, distanceSML, distanceMED, distanceLRG
   
   ; compute the blended travel distance for each truck class
   ;   - very small
   mw[1] = (mi.1.DISTVSM) * (1.0-TRUCK_DISTRIB_LOS_TOLL_PART) +
           (mi.1.TOLLDISTVSM) * (    TRUCK_DISTRIB_LOS_TOLL_PART)
   
   ;   - small
   mw[2] = (mi.1.DISTSML) * (1.0-TRUCK_DISTRIB_LOS_TOLL_PART) +
           (mi.1.TOLLDISTSML) * (    TRUCK_DISTRIB_LOS_TOLL_PART)
   
   ;   - medium
   mw[3] = (mi.1.DISTMED) * (1.0-TRUCK_DISTRIB_LOS_TOLL_PART) +
           (mi.1.TOLLDISTMED) * (TRUCK_DISTRIB_LOS_TOLL_PART)

   ;   - large
   mw[4] = (mi.1.DISTLRG) * (1.0-TRUCK_DISTRIB_LOS_TOLL_PART) +
           (mi.1.TOLLDISTLRG) * (TRUCK_DISTRIB_LOS_TOLL_PART)
endrun

; step two: apply the distribution models
run pgm = tripdist

   ; read in the trip generation output
   filei zdati[1] = nonres\TruckTG.dat, z = 1-12, verySmallTruckP = 13-24, verySmallTruckA = 25-36,
                                                      smallTruckP = 37-48,     smallTruckA = 49-60,
                                                     mediumTruckP = 61-72,    mediumTruckA = 73-84, 
                                                      largeTruckP = 85-96,     largeTruckA = 97-108
                                                
   ; read in the level of service matrix with the blended distance
   filei mati[1] = nonres\blendedTruckDistance.tpp
   
   ; read in the k-factors
   ; filei mati[2] = nonres\truckkfact.k22.z1454.mat
   
   ; write out the results
   fileo mato[1] = nonres\DailyTruckTrips.tpp, mo = 5-8, name = verySmall, small, medium, large 
                                                
   ; set the parameters
   ;   - maximum iterations is 99
   maxiters = 99
   
   ;   - maximum root mean square error is 10
   maxrmse = 10
   
   ;   - number of zones
   zones = @token_number_of_internal_zones@ 
   
   ; set the production and attraction variables
   setpa p[1] = zi.1.verySmallTruckP
   setpa a[1] = zi.1.verySmallTruckA
   
   setpa p[2] = zi.1.smallTruckP
   setpa a[2] = zi.1.smallTruckA
   
   setpa p[3] = zi.1.mediumTruckP
   setpa a[3] = zi.1.mediumTruckA
   
   setpa p[4] = zi.1.largeTruckP
   setpa a[4] = zi.1.largeTruckA
   
   ; set the friction factors (distance is in column 1, very small FF in 2, small FF in 3, medium FF in 4, and large FF in 5)
   lookup list = Y, file = nonres\truckFF_distance_based.dat, name = truckff,
          lookup[1] = 1, result = 2,
          lookup[2] = 1, result = 3,
          lookup[3] = 1, result = 4,
          lookup[4] = 1, result = 5,
          interpolate = Y, setupper = N
          
   ; apply the gravity models
   gravity purpose = 1, los = mi.1.distanceVSM, ffactors = truckff
   gravity purpose = 2, los = mi.1.distanceSML, ffactors = truckff
   gravity purpose = 3, los = mi.1.distanceMED, ffactors = truckff
   gravity purpose = 4, los = mi.1.distanceLRG, ffactors = truckff
   
   ; scale the trips by 100 and bucket round (to be consistent with Chuck's application)
   mw[5] = mw[1] * 100.0
   mw[6] = mw[2] * 100.0
   mw[7] = mw[3] * 100.0
   mw[8] = mw[4] * 100.0
   
   temp = rowfix(5) + rowfix(6) + rowfix(7) + rowfix(8)
   
endrun

