; ----------------------------------------------------------------------------------------------------------------
;
; TruckTripGeneration.job
;
;  As part of the TM-1.7 Freight Model Update, the small (two-axle, six-tire), medium (three-axle), and large
; (four-or-more-axle) truck generation models were re-estimated using the 2020 California Statewide Freight Forecasting
; and Travel Demand Model, version 2 (CSF2TDM, 2020) as the calibration target.
;
; Version TM-1.6 and before, these small, medium, and large truck models originated in the BAYCAST truck model, with
; coefficients taken from the "I-880 Intermodal Corridor Study: Truck Travel in the San Francisco Bay Area"
; (Barton Aschman, December 1992) and subsequently re-estimated from SIC- to NAICS-based employment categories
; to mimic the original model. The TM-1.7 re-estimation described above supersedes those coefficients.
;
; The very small (four-tire) truck generation model is unchanged from the prior TM-1.6 implementation, which is
; based on the Phoenix four-tire truck model documented in the TMIP Quick Response Freight Manual.
;
; As documented in GitHub Issue #95, the truck market segmentation was updated from the prior garage / non-garage
; structure to a freight / non-freight structure.  For small, medium, and large trucks, non-freight (linked) and
; freight trip ends are generated separately below and then summed into a single trip table per truck class.  The
; very small truck class consists of linked (non-freight) trips only.  All models use linear regression to
; generate trip ends, with attractions balanced to productions within each segment.
;
; Employment inputs use the NAICS-based employment categories carried in the zonal land use data.  Please see the
; TM-1.7 Freight Model Update documentation for the estimation datasets, coefficients, and diagnostics
; (utilities/trucks/trucks_2026_update/).
;
; Input:  (1) Zonal database in DBF format with the following fields: (a) TOTEMP, total employment; (b) RETEMPN,
;             retail trade employment (NAICS); (c) FPSEMPN, financial and professional services employment
;             (NAICS); (d) HEREMPN, health, educational, and recreational employment (NAICS); (e) OTHEMPN, other
;             employment (NAICS); (f) AGREMPN, agricultural employment (NAICS); (g) MWTEMPN, manufacturing,
;             warehousing, and transportation employment (NAICS); and, (h) TOTHH, total households.
;
; Output: (1) An ASCII file containing the following fields: (a) zone number; (b) very small truck trip productions;
;             (c) very small truck trip attractions; (d) small truck trip productions; (e) small truck trip attractions;
;             (f) medium truck trip productions; (g) medium truck trip attractions; (h) large truck trip productions;
;             and, (i) large truck trip attractions.
;
; Notes:  (1) The small, medium, and large truck generation models were re-estimated for TM-1.7 against CSF2TDM
;             2020 freight demand; the very small truck model is retained from TM-1.6.
;         (2) Truck segmentation was changed from garage / non-garage to freight / non-freight (see Issue #95).
;
; See also: (1) TruckTripDistribution.job, which applies the distribution model. 
;           (2) TruckTimeOfDay.job, which applies diurnal factors to the daily trips generated here. 
;           (3) TruckTollChoice.job, which applies a toll/no toll choice model for trucks.
;
; version:  Travel Model One
; authors:  Juan Caicedo (WSP) (2026 06 15); dto (2010 08 31); cp (date unknown)
;
;
; ----------------------------------------------------------------------------------------------------------------

; set the number of zones token
token_number_of_internal_zones = 1454

; apply the generation models
run pgm = tripgen

   ; read in the zonal data in DBF format
   filei zdati[1] = landuse\tazdata.dbf
   
   ; write the generation results to a DBF
   fileo pao[1] = nonres\TruckTGx.dbf, form = 12.0, dbf = T, list = z, p[1], p[2], p[3], p[4], p[5], p[6], p[7],
                                                                       a[1], a[2], a[3], a[4], a[5], a[6], a[7] 
   
   ; only apply the model for internal zones
   zones = @token_number_of_internal_zones@
   
   ; loop through the origin zones
   phase = iloop
   
      ; Very small truck productions — linked (non-freight) trips only; model retained from TM-1.6.
      ; The 0.4 factor combines Chuck's calibration adjustment into the NAICS-based very small truck coefficients.
      linkedVerySmallP = round(0.4 * (0.95409 * zi.1.RETEMPN + 0.54333 * zi.1.FPSEMPN + 0.50769 * zi.1.HEREMPN +
                               0.63558 * zi.1.OTHEMPN + 1.10181 * zi.1.AGREMPN + 0.81576 * zi.1.MWTEMPN +
                               0.26565 * ZI.1.TOTHH) )


      small_non_freight_production = ROUND(0.10006 * zi.1.TOTHH + 1.11749 * SQRT(zi.1.TOTEMP) + 122.98079 * (zi.1.RETEMPN / MAX(1, zi.1.TOTEMP)) +
                                           39.15454 * (zi.1.HEREMPN / MAX(1, zi.1.TOTEMP)))

      medium_non_freight_production = ROUND(0.02157 * zi.1.TOTHH + 0.46968 * SQRT(zi.1.TOTEMP) + 24.16532 * (zi.1.RETEMPN / MAX(1, zi.1.TOTEMP)) +
                                            4.75493 * (zi.1.HEREMPN / MAX(1, zi.1.TOTEMP)))

      large_non_freight_production = ROUND(0.00633 * zi.1.RETEMPN + 0.00331 * zi.1.FPSEMPN + 0.21266 * SQRT(zi.1.TOTEMP))

      ; non-garage-based, or linked trips, or Non-freight - attractions (equal productions)
      linkedVerySmallA = linkedVerySmallP
      small_non_freight_attraction     = small_non_freight_production
      medium_non_freight_attraction    = medium_non_freight_production
      large_non_freight_attraction     = large_non_freight_production
      
      ; Freight - productions (updated NAICS coefficients)
      small_freight_production = ROUND( 0.00043 * zi.1.RETEMPN + 0.05249 * zi.1.AGREMPN + 0.00098 * zi.1.MWTEMPN + 0.00075 * zi.1.FPSEMPN)

      medium_freight_production =  ROUND( 0.00635 * zi.1.RETEMPN + 0.21963 * zi.1.AGREMPN + 0.00599 * zi.1.MWTEMPN + 0.00451 * zi.1.FPSEMPN)

      large_freight_production = ROUND( 0.00712 * zi.1.RETEMPN + 0.18367 * zi.1.AGREMPN + 0.00521 * zi.1.MWTEMPN + 0.00344 * zi.1.FPSEMPN)

      ; Freight - attractions
      small_freight_attraction = ROUND(0.00285 * zi.1.RETEMPN  + 0.00035 * zi.1.FPSEMPN + 0.00714 * zi.1.HEREMPN +
                                       0.00062 * zi.1.OTHEMPN  + 0.00013 * zi.1.AGREMPN + 0.00028 * zi.1.MWTEMPN)

      medium_freight_attraction = ROUND(0.01634 * zi.1.RETEMPN  + 0.00369 * zi.1.FPSEMPN + 0.00140 * zi.1.HEREMPN +
                                        0.00076 * zi.1.OTHEMPN  + 0.03559 * zi.1.AGREMPN + 0.00243 * zi.1.MWTEMPN)

      large_freight_attraction = ROUND(0.01461 * zi.1.RETEMPN  + 0.00282 * zi.1.FPSEMPN + 0.00116 * zi.1.HEREMPN +
                                       0.00075 * zi.1.OTHEMPN  + 0.03851 * zi.1.AGREMPN + 0.00209 * zi.1.MWTEMPN)

      ; set the TP+ trip generation variables prior to balance phase
      p[1] = linkedVerySmallP
      p[2] = small_non_freight_production
      p[3] = medium_non_freight_production
      p[4] = large_non_freight_production
      p[5] = small_freight_production
      p[6] = medium_freight_production
      p[7] = large_freight_production
      
      a[1] = linkedVerySmallA
      a[2] = small_non_freight_attraction
      a[3] = medium_non_freight_attraction
      a[4] = large_non_freight_attraction
      a[5] = small_freight_attraction
      a[6] = medium_freight_attraction
      a[7] = large_freight_attraction
      
   endphase
   
   ; balance attractions to productions
   phase = adjust
   
      a[1] = p[1][0] / a[1][0] * a[1]
      a[2] = p[2][0] / a[2][0] * a[2]
      a[3] = p[3][0] / a[3][0] * a[3]
      a[4] = p[4][0] / a[4][0] * a[4]
      a[5] = p[5][0] / a[5][0] * a[5]
      a[6] = p[6][0] / a[6][0] * a[6]
      a[7] = p[7][0] / a[7][0] * a[7]
   
   endphase
   
endrun

; combine the linked and garage-based trips for each class of truck
run pgm = matrix

   filei zdati[1] = nonres\TruckTGx.dbf
   
   zones = @token_number_of_internal_zones@
   
   ; very small only has linked trips
   verySmallTruckP = zi.1.P1
   verySmallTruckA = zi.1.A1
   
   ; small, medium, and large has linked and unlinked
   smallTruckP  = zi.1.P2 + zi.1.P5
   smallTruckA  = zi.1.A2 + zi.1.A5
   
   mediumTruckP = zi.1.P3 + zi.1.P6
   mediumTruckA = zi.1.A3 + zi.1.A6
   
   largeTruckP  = zi.1.P4 + zi.1.P7
   largeTruckA  = zi.1.A4 + zi.1.A7
   
   list = z(12), verySmallTruckP(12.0), verySmallTruckA(12.0), smallTruckP(12.0), smallTruckA(12.0),
                 mediumTruckP(12.0),    mediumTruckA(12.0),    largeTruckP(12.0), largeTruckA(12.0),
          file = nonres\TruckTG.dat

endrun


