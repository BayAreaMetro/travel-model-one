# Copy to .env and adjust for your machine.  Everything machine-specific lives
# here, so config.yaml stays the model recipe and nothing else.
#
# The project config reads these as {env:NAME}.  An unset variable is an error
# naming it, not a silent empty string.

# --- required: where a run reads from, and where it happens ------------------

# Inputs are copied FROM here.  A run never writes into it.
# Supplies INPUT/ (landuse, networks, popsyn, warmstart demand, params.properties)
# and, for now, CTRAMP/ -- the model scripts and UECs, so a parity run executes the
# reference run's copy rather than this branch's.
TM1_REFERENCE_RUN=//MODEL3-C/Model3C-Share/Projects/2023_TM161_IPA_35_testrun

# Where the run happens.  Needs room for the full model output (~100 GB) and
# should be a local disk -- Cube's cluster is chatty and a network path is slow.
TM1_PROJ_DIR=E:/Tests/base_2023_ctramp

# --- required: what the legacy model code needs to find on this machine ------

# BuildTransitNetworks.job calls gawk itself -- to derive transit egress links and to
# pick park-and-ride lots -- so gawk has to be on PATH when Cube runs it, as it was in
# RunModel.bat's shell.  Windows has no awk; Git for Windows bundles one at usr/bin.
# A wrong path does not make the job exit non-zero -- the shell redirect creates its
# output files, empty -- so build_transit_networks declares them under `verify:` and
# fails there rather than three steps later.
TM1_GAWK_DIR=C:/Program Files/Git/usr/bin

# --- optional: only if these are in non-standard locations -------------------
# VoyagerFileAccess DLLs are bundled -- no config needed for TPP->OMX.

# RUNTPP_PATH=C:\Program Files\Citilabs\CubeVoyager
# R_HOME=C:\Program Files\R\R-4.2.1
