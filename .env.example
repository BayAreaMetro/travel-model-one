# Copy to .env and adjust for this machine.  Machine-specific things only, so
# config.yaml stays the model recipe.  The config reads these as {env:NAME}; an
# unset one is an error naming it, never a silent empty string.

# --- required ----------------------------------------------------------------

# The model data share, and no more of the path than that -- which network, which
# land use, which previous run are written out in config.yaml where they can be
# reviewed.  Drive letter where it is mapped, UNC where it is not; that difference
# is the whole reason this is here.
TM1_M_DRIVE=//models.ad.mtc.ca.gov/data/models

# Where runs go, as {project}/{case}-{NNN} beneath this.  Local disk (~100 GB per
# run, and Cube's cluster is too chatty for a network path), and keep it SHORT --
# Cube and the Java stack are not long-path aware and a run nests ~160 characters.
TM1_RUNS_ROOT=E:/runs

# gawk, which BuildTransitNetworks.job shells out to.  Windows has none; Git for
# Windows bundles one.  A wrong path here does not fail loudly -- the shell redirect
# creates the output files, empty -- so the step verifies them and fails there.
TM1_GAWK_DIR=C:/Program Files/Git/usr/bin

# A finished CT-RAMP run.  The ActivitySim projects consume its skims and loaded
# networks rather than building them, so this names the run they start from.
TM1_CTRAMP_RUN=//MODEL3-C/Model3C-Share/Projects/2023_TM161_IPA_35_testrun

# --- optional ----------------------------------------------------------------

# The three Cube files this needs.  Shown here are the installer defaults, already
# set in code -- name one only when this machine differs.  Their directories go on
# PATH and Java's library path automatically, so a Bentley OpenPaths install is just
# TM1_RUNTPP pointing there, not a separate setting.

# TM1_RUNTPP=C:\Program Files\Citilabs\CubeVoyager\runtpp.exe
# TM1_CLUSTER=C:\Program Files\Citilabs\CubeVoyager\Cluster.exe
# TM1_VOYAGER_DLL=C:\Program Files\Citilabs\VoyagerFileAPI\VoyagerFileAccess.dll

# Slack.  Either the URL, or a file holding it so a shared webhook stays off every
# machine.  With neither, runs log their milestones and send nothing.  How much is
# sent is `slack:` in the project config, not here.
TM1_SLACK_WEBHOOK_FILE=//models.ad.mtc.ca.gov/data/models/Software/Slack/TravelModel_SlackWebhook.txt
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
