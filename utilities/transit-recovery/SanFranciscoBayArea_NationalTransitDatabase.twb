                <zone fixed-size='294' forceUpdate='true' h='37750' id='76' type-v2='text' w='49200' x='50000' y='50750'>
                  <formatted-text>
                    <run fontsize='12'>National Transit Database data sourced from: </run>
                    <run auto-url='true' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://www.transit.dot.gov/ntd/data-product/monthly-module-raw-data-release&amp;quot;'>https://www.transit.dot.gov/ntd/data-product/monthly-module-raw-data-release</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>NTD data is monthly, so Average Daily data reported here is simply divided by the number of days in the month.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>Last updated Aug 11,  2026 using</run>
                    <run>Æ&#10;</run>
