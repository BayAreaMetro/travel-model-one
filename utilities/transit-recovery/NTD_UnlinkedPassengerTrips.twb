      <aliases enabled='yes' />
      <column caption='Year + Month' datatype='string' name='[Calculation_0686403289260032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str([year])+&quot;-&quot;+RIGHT(&quot;0&quot;+str([month_int]),2)' />
      </column>
      <column caption='Est Weekday UPT by Operator/Year/Month' datatype='real' name='[Calculation_0686403289677825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Calculation_0686403289260032],[Common.Agency.Name]: SUM([average.daily.Unlinked.Passenger.Trips]) }' />
      </column>
      <column caption='Date' datatype='datetime' name='[Calculation_1794965985970610179]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPARSE ( &quot;yyyy-MMM&quot;, str([year])+&quot;-&quot;+[month] )' />
      </column>
      <column datatype='string' name='[Common.Agency.Name]' role='dimension' type='nominal' />
      <column caption='Est Weekend UPT by Operator/Year/Month' datatype='real' name='[Est Weekday UPT by Operator/Year/Month (copy)_0686403290181634]' role='measure' type='quantitative'>
